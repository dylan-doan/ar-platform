# Copy to .env.local and fill in.

# Platform backend (default: production). For local dev: http://localhost:8000
# ZOUSTEC_API_BASE=https://zoustec-backend.onrender.com

# REQUIRED for live data: the customer's tenant slug (e.g. bnk).
# Leave unset to render data/design.json fully offline with placeholder branding.
ZOUSTEC_TENANT_SLUG=

# Optional: pin one event. Unset = the event named inside data/design.json,
# falling back to the tenant's homepage rule.
# ZOUSTEC_EVENT_SLUG=
